rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'Borulelo@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entities validation helpers
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['id']) &&
        data.keys().hasOnly(['id', 'email', 'username', 'displayName', 'avatarUrl', 'bio', 'createdAt', 'updatedAt']) &&
        data.id == uid &&
        (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500));
    }

    function isValidBrand(data) {
      return data.keys().hasAll(['id', 'name', 'slug']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'category', 'country', 'description', 'logoUrl', 'website', 'trustScore', 'riskScore', 'status', 'isVerified', 'isAutoSourced', 'claimStatus', 'ownerEmail', 'verifiedDomain', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('status' in data) || (data.status in ['active', 'pending', 'flagged'])) &&
        (!('isVerified' in data) || (data.isVerified is bool)) &&
        (!('isAutoSourced' in data) || (data.isAutoSourced is bool)) &&
        (!('claimStatus' in data) || (data.claimStatus in ['unclaimed', 'claimed'])) &&
        (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200)) &&
        (!('verifiedDomain' in data) || (data.verifiedDomain is string && data.verifiedDomain.size() <= 200));
    }

    function isAutoSourcedOrUnclaimedBrand(data) {
      return !('createdBy' in data) ||
        data.createdBy in ['system', 'seed-catalog', 'admin-wikidata-importer', 'admin-dashboard-importer', 'admin-importer'] ||
        (('claimStatus' in data) && data.claimStatus == 'unclaimed') ||
        (('isAutoSourced' in data) && data.isAutoSourced == true && !('verifiedDomain' in data));
    }

    function isValidBrandClaim(data) {
      return data.keys().hasAll(['id', 'brandId', 'brandSlug', 'brandName', 'claimantUid', 'claimantEmail', 'emailDomain', 'domainMatchStatus', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'brandId', 'brandSlug', 'brandName', 'brandWebsite', 'officialDomain', 'claimantUid', 'claimantEmail', 'emailDomain', 'roleTitle', 'domainMatchStatus', 'verificationCode', 'status', 'message', 'reviewedBy', 'verifiedAt', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.brandId is string && data.brandId.size() <= 128 &&
        data.brandSlug is string && data.brandSlug.size() <= 200 &&
        data.brandName is string && data.brandName.size() <= 200 &&
        data.claimantUid == request.auth.uid &&
        data.claimantEmail is string && data.claimantEmail.size() <= 200 &&
        data.emailDomain is string && data.emailDomain.size() <= 200 &&
        (data.domainMatchStatus in ['matched', 'subdomain_match', 'mismatch', 'free_provider', 'no_website', 'invalid_email']) &&
        (data.status in ['code_sent', 'verified_domain', 'pending_review', 'approved', 'rejected']) &&
        (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 120)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 1000));
    }

    function isValidEcosystemItem(data) {
      return data.keys().hasAll(['id', 'brandId', 'brandSlug', 'brandName', 'itemType', 'title', 'summary', 'authorUid', 'authorName', 'upvotes', 'rsvpCount', 'createdAt']) &&
        data.keys().hasOnly(['id', 'brandId', 'brandSlug', 'brandName', 'itemType', 'title', 'summary', 'category', 'status', 'eventDate', 'location', 'compensation', 'externalUrl', 'authorUid', 'authorName', 'upvotes', 'rsvpCount', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 200 &&
        (data.itemType in ['release', 'innovation_presentation', 'innovation_submission', 'event', 'collab']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.summary is string && data.summary.size() > 0 && data.summary.size() <= 2000 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.upvotes is number && data.upvotes >= 0 &&
        data.rsvpCount is number && data.rsvpCount >= 0;
    }

    function isValidCollabApplication(data) {
      return data.keys().hasAll(['id', 'itemId', 'itemTitle', 'brandId', 'brandSlug', 'brandName', 'brandOwnerUid', 'applicantUid', 'applicantName', 'kind', 'pitch', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'itemId', 'itemTitle', 'brandId', 'brandSlug', 'brandName', 'brandOwnerUid', 'applicantUid', 'applicantName', 'applicantEmail', 'kind', 'pitch', 'portfolioUrl', 'status', 'brandReply', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.applicantUid is string && data.applicantUid.size() <= 128 &&
        (data.kind in ['rsvp', 'collab_application']) &&
        data.pitch is string && data.pitch.size() > 0 && data.pitch.size() <= 2000 &&
        (data.status in ['submitted', 'shortlisted', 'accepted', 'declined']);
    }

    function isValidBrandVote(data, brandId) {
      return data.keys().hasAll(['id', 'brandId', 'userId', 'voteType']) &&
        data.keys().hasOnly(['id', 'brandId', 'userId', 'voteType', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.brandId == brandId &&
        (data.voteType == 'stash' || data.voteType == 'trash');
    }

    function isValidCrisisAlert(data) {
      return data.keys().hasAll(['id', 'brandId', 'title', 'severity', 'status']) &&
        data.keys().hasOnly(['id', 'brandId', 'title', 'description', 'severity', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() <= 200 &&
        (data.severity in ['low', 'medium', 'high', 'critical']) &&
        (data.status in ['active', 'resolved', 'investigating']);
    }

    function isValidIncident(data) {
      return data.keys().hasAll(['id', 'brandId', 'title', 'severity', 'status']) &&
        data.keys().hasOnly(['id', 'brandId', 'title', 'details', 'severity', 'status', 'reportedBy', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() <= 200 &&
        (data.severity in ['low', 'medium', 'high', 'critical']) &&
        (data.status in ['open', 'investigating', 'resolved', 'dismissed']);
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'content']) &&
        data.keys().hasOnly(['id', 'senderId', 'receiverId', 'content', 'createdAt']) &&
        data.senderId == request.auth.uid &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 3000;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'read']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'body', 'read', 'createdAt']) &&
        data.title is string && data.title.size() <= 200 &&
        data.read is bool;
    }

    function isValidFriend(data) {
      return data.keys().hasAll(['id', 'requesterId', 'addresseeId', 'status']) &&
        data.keys().hasOnly(['id', 'requesterId', 'addresseeId', 'status', 'bondTag', 'createdAt', 'updatedAt']) &&
        data.requesterId is string && data.addresseeId is string &&
        data.requesterId != data.addresseeId &&
        (data.status in ['pending', 'accepted', 'blocked']) &&
        (!('bondTag' in data) || (data.bondTag is string && data.bondTag.size() <= 50));
    }

    // Health / connection test rule
    match /test/{docId} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only root provisioned or backend
    }

    // User profiles
    match /users/{userId} {
      allow get: if true; // Public profiles
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming(), userId);
      allow update: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId && isValidUserProfile(incoming(), userId) && incoming().id == existing().id) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Brands collection
    match /brands/{brandId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidId(brandId) && isValidBrand(incoming());
      allow update: if isSignedIn() && isValidId(brandId) && (
        isAdmin() ||
        (isValidBrand(incoming()) && incoming().id == existing().id && incoming().slug == existing().slug && (
          existing().createdBy == request.auth.uid ||
          (isAutoSourcedOrUnclaimedBrand(existing()) && incoming().createdBy == request.auth.uid)
        ))
      );
      allow delete: if isAdmin();

      // Brand subcollection: votes
      match /votes/{voteId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isValidId(voteId) && isValidBrandVote(incoming(), brandId);
        allow update: if isSignedIn() && isValidId(voteId) && (
          (request.auth.uid == existing().userId && isValidBrandVote(incoming(), brandId)) ||
          isAdmin()
        );
        allow delete: if isSignedIn() && (request.auth.uid == existing().userId || isAdmin());
      }
    }

    // Brand Ownership Claims & Domain Email Verification
    match /brand_claims/{claimId} {
      allow get: if isSignedIn() && isValidId(claimId) && (
        resource == null ||
        existing().claimantUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().claimantUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(claimId) && isValidBrandClaim(incoming()) && (
        incoming().status != 'approved' &&
        (incoming().status != 'verified_domain' || incoming().domainMatchStatus in ['matched', 'subdomain_match'])
      );
      allow update: if isSignedIn() && isValidId(claimId) && (
        isAdmin() ||
        (existing().claimantUid == request.auth.uid &&
          isValidBrandClaim(incoming()) &&
          incoming().claimantUid == existing().claimantUid &&
          incoming().status != 'approved' &&
          (incoming().status != 'verified_domain' || incoming().domainMatchStatus in ['matched', 'subdomain_match']))
      );
      allow delete: if isAdmin();
    }

    // Brand Ecosystem (New Releases, Innovation Presentations & Submissions, Events & Collabs)
    match /brand_ecosystem_items/{itemId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(itemId) &&
        incoming().authorUid == request.auth.uid &&
        isValidEcosystemItem(incoming());
      allow update: if isSignedIn() && isValidId(itemId) && isValidEcosystemItem(incoming()) && (
        isAdmin() ||
        (existing().authorUid == request.auth.uid &&
          incoming().authorUid == existing().authorUid) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'rsvpCount', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || isAdmin());
    }

    // Event RSVPs & B2C/C2B Collaboration Applications (Private PII protected)
    match /brand_collab_applications/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId) && (
        resource == null ||
        existing().applicantUid == request.auth.uid ||
        existing().brandOwnerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().applicantUid == request.auth.uid ||
        existing().brandOwnerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(applicationId) &&
        incoming().applicantUid == request.auth.uid &&
        isValidCollabApplication(incoming());
      allow update: if isSignedIn() && isValidId(applicationId) && isValidCollabApplication(incoming()) && (
        isAdmin() ||
        (existing().brandOwnerUid == request.auth.uid &&
          incoming().applicantUid == existing().applicantUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'brandReply', 'updatedAt'])) ||
        (existing().applicantUid == request.auth.uid &&
          incoming().applicantUid == existing().applicantUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['pitch', 'portfolioUrl', 'status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && (existing().applicantUid == request.auth.uid || isAdmin());
    }

    // Crisis alerts
    match /brand_crisis_alerts/{alertId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(alertId) && (isAdmin() || isValidCrisisAlert(incoming()));
      allow update: if isSignedIn() && isValidId(alertId) && (isAdmin() || isValidCrisisAlert(incoming()));
      allow delete: if isAdmin();
    }

    // Incidents
    match /incidents/{incidentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(incidentId) && isValidIncident(incoming());
      allow update: if isSignedIn() && isValidId(incidentId) && (isAdmin() || isValidIncident(incoming()));
      allow delete: if isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming());
      allow update: if false; // Messages are immutable
      allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isSignedIn() && isValidId(notificationId) && (
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Friends / Mutual Connections
    match /friends/{friendId} {
      allow get: if isSignedIn() && isValidId(friendId) && (
        resource == null ||
        existing().requesterId == request.auth.uid ||
        existing().addresseeId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().requesterId == request.auth.uid ||
        existing().addresseeId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(friendId) &&
        incoming().requesterId == request.auth.uid &&
        isValidFriend(incoming());
      allow update: if isSignedIn() && isValidId(friendId) && (
        isAdmin() ||
        ((existing().requesterId == request.auth.uid || existing().addresseeId == request.auth.uid) &&
          isValidFriend(incoming()) &&
          incoming().requesterId == existing().requesterId &&
          incoming().addresseeId == existing().addresseeId)
      );
      allow delete: if isSignedIn() && (
        existing().requesterId == request.auth.uid ||
        existing().addresseeId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
