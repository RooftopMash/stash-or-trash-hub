{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile and identity information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "createdAt"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Brand record with trust and risk assessment metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 500 },
        "trustScore": { "type": "number" },
        "riskScore": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "pending", "flagged"] },
        "isVerified": { "type": "boolean" },
        "isAutoSourced": { "type": "boolean" },
        "claimStatus": { "type": "string", "enum": ["unclaimed", "claimed"] },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "verifiedDomain": { "type": "string", "maxLength": 200 },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "slug", "createdAt"]
    },
    "BrandVote": {
      "title": "BrandVote",
      "description": "Community vote for a brand: stash or trash",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "userId": { "type": "string" },
        "voteType": { "type": "string", "enum": ["stash", "trash"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "brandId", "userId", "voteType", "createdAt"]
    },
    "BrandCrisisAlert": {
      "title": "BrandCrisisAlert",
      "description": "Real-time brand safety crisis warnings and alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["active", "resolved", "investigating"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "brandId", "title", "severity", "status", "createdAt"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Documented incident log associated with a brand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 4000 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved", "dismissed"] },
        "reportedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "brandId", "title", "severity", "status", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "User direct or community chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderId", "content", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 1000 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "read", "createdAt"]
    },
    "Friend": {
      "title": "Friend",
      "description": "Mutual connection request between users with pending, accepted, or blocked status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterId": { "type": "string" },
        "addresseeId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "blocked"] },
        "bondTag": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "requesterId", "addresseeId", "status", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "System connectivity heartbeat probe",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    },
    "BrandClaim": {
      "title": "BrandClaim",
      "description": "Domain-matched brand ownership claim and corporate email verification record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "brandSlug": { "type": "string" },
        "brandName": { "type": "string" },
        "brandWebsite": { "type": "string" },
        "officialDomain": { "type": "string" },
        "claimantUid": { "type": "string" },
        "claimantEmail": { "type": "string" },
        "emailDomain": { "type": "string" },
        "roleTitle": { "type": "string", "maxLength": 120 },
        "domainMatchStatus": { "type": "string", "enum": ["matched", "subdomain_match", "mismatch", "free_provider", "no_website", "invalid_email"] },
        "verificationCode": { "type": "string" },
        "status": { "type": "string", "enum": ["code_sent", "verified_domain", "pending_review", "approved", "rejected"] },
        "message": { "type": "string", "maxLength": 1000 },
        "reviewedBy": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "brandId", "brandSlug", "brandName", "claimantUid", "claimantEmail", "emailDomain", "domainMatchStatus", "status", "createdAt"]
    },
    "BrandEcosystemItem": {
      "title": "BrandEcosystemItem",
      "description": "Brand new releases, innovation presentations & C2B submissions, events, and collaboration opportunities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "brandSlug": { "type": "string" },
        "brandName": { "type": "string" },
        "itemType": { "type": "string", "enum": ["release", "innovation_presentation", "innovation_submission", "event", "collab"] },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 80 },
        "eventDate": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 200 },
        "compensation": { "type": "string", "maxLength": 200 },
        "externalUrl": { "type": "string", "maxLength": 500 },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "upvotes": { "type": "number" },
        "rsvpCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "brandId", "brandSlug", "brandName", "itemType", "title", "summary", "authorUid", "authorName", "upvotes", "rsvpCount", "createdAt"]
    },
    "BrandCollabApplication": {
      "title": "BrandCollabApplication",
      "description": "Event RSVP and B2C/C2B collaboration partnership applications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemTitle": { "type": "string" },
        "brandId": { "type": "string" },
        "brandSlug": { "type": "string" },
        "brandName": { "type": "string" },
        "brandOwnerUid": { "type": "string" },
        "applicantUid": { "type": "string" },
        "applicantName": { "type": "string", "maxLength": 100 },
        "applicantEmail": { "type": "string", "maxLength": 200 },
        "kind": { "type": "string", "enum": ["rsvp", "collab_application"] },
        "pitch": { "type": "string", "maxLength": 2000 },
        "portfolioUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["submitted", "shortlisted", "accepted", "declined"] },
        "brandReply": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "itemId", "itemTitle", "brandId", "brandSlug", "brandName", "brandOwnerUid", "applicantUid", "applicantName", "kind", "pitch", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by auth UID"
    },
    "/brands/{brandId}": {
      "schema": "Brand",
      "description": "Catalog of brands with safety and trust ratings"
    },
    "/brands/{brandId}/votes/{voteId}": {
      "schema": "BrandVote",
      "description": "User stash/trash votes on a brand"
    },
    "/brand_claims/{claimId}": {
      "schema": "BrandClaim",
      "description": "Domain-matched brand ownership claims and email verification records"
    },
    "/brand_ecosystem_items/{itemId}": {
      "schema": "BrandEcosystemItem",
      "description": "Published brand releases, innovation presentations & submissions, events, and B2C/C2B collaboration briefs"
    },
    "/brand_collab_applications/{applicationId}": {
      "schema": "BrandCollabApplication",
      "description": "Private user RSVPs and B2C/C2B collaboration proposals"
    },
    "/brand_crisis_alerts/{alertId}": {
      "schema": "BrandCrisisAlert",
      "description": "Active brand safety crisis warnings"
    },
    "/incidents/{incidentId}": {
      "schema": "Incident",
      "description": "Brand incidents and investigations"
    },
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct communication messages"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/friends/{friendId}": {
      "schema": "Friend",
      "description": "Mutual connection requests and friendships between users"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Admin authorization records"
    },
    "/test/{docId}": {
      "schema": "ConnectionTest",
      "description": "Firestore connection health probe"
    }
  }
}
